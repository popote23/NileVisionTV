<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/bg">
    <ListView android:id="@+id/cats" android:layout_width="230dp" android:layout_height="match_parent"
        android:background="@color/panel" android:listSelector="@drawable/sel" android:divider="#22FFFFFF" android:dividerHeight="1dp"/>
    <ListView android:id="@+id/chans" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:listSelector="@drawable/sel" android:divider="#22FFFFFF" android:dividerHeight="1dp"/>
    <FrameLayout android:id="@+id/playerBox" android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="match_parent" android:background="#000000">
        <com.google.android.exoplayer2.ui.StyledPlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent"
            app:use_controller="false"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
            android:text="Choisissez une chaîne" android:textColor="@color/gold" android:textSize="20sp"/>
        <TextView android:id="@+id/now" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="top"
            android:background="#99000000" android:padding="8dp" android:textColor="#FFFFFF" android:textSize="18sp"/>
    </FrameLayout>
</LinearLayout>
